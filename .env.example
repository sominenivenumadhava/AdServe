# ==============================================================================
# AdServe — Environment Variables Reference Template (.env.example)
#
# LOCAL DEVELOPMENT (Docker Compose):
#   Copy this file to .env:
#     cp .env.example .env
#
# PRODUCTION DEPLOYMENT (Railway & Vercel):
#   Set these environment variables in your respective cloud project dashboards.
#   NEVER commit actual production passwords or JWT secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Boot Core & Server Configuration
# ------------------------------------------------------------------------------
# Active Spring profile: 'mysql' for local docker, 'prod' for Railway
SPRING_PROFILES_ACTIVE=prod
# Server listening port (Railway automatically injects $PORT)
PORT=8080
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 2. Production Database (Railway MySQL)
# ------------------------------------------------------------------------------
# Standard database variables (or Railway native MYSQL* variables)
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_NAME=railway
DB_USERNAME=root
DB_PASSWORD=your_secure_railway_db_password

# Local Docker Compose port mapping override (defaults to 3308 on host)
DB_HOST_PORT=3308
MYSQL_DATABASE=adserve_db
MYSQL_USER=adserve_user
MYSQL_PASSWORD=change_me_local_db_password
MYSQL_ROOT_PASSWORD=change_me_local_root_password

# ------------------------------------------------------------------------------
# 3. Production In-Memory Cache (Railway Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=redis.railway.internal
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_railway_redis_password
ADSERVE_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 4. Production Event Streaming (Apache Kafka)
# ------------------------------------------------------------------------------
# Kafka broker bootstrap servers (e.g., railway internal host or cloud broker)
KAFKA_BOOTSTRAP_SERVERS=kafka.railway.internal:9092
KAFKA_AUTO_STARTUP=true
KAFKA_TOPIC_IMPRESSIONS=ad-impressions
KAFKA_TOPIC_CLICKS=ad-clicks

# ------------------------------------------------------------------------------
# 5. Security, JWT & Authentication
# ------------------------------------------------------------------------------
# Provide a cryptographically secure 256-bit+ hexadecimal secret
JWT_SECRET=your_secure_random_256_bit_hex_secret_key_minimum_64_chars
# JWT expiration duration in milliseconds (e.g., 86400000 = 24 hours)
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# 6. CORS Allowed Origins (Link Backend to Frontend)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Set to your actual Vercel deployment URL:
# Example: https://adserve-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-adserve-frontend.vercel.app,http://localhost:5173,http://localhost:80

# ------------------------------------------------------------------------------
# 7. Frontend Environment Variables (Configure in Vercel Project Settings)
# ------------------------------------------------------------------------------
# The publicly accessible URL of the Railway-deployed backend:
# Example: https://adserve-backend-production.up.railway.app
VITE_API_BASE_URL=https://your-adserve-backend.up.railway.app
